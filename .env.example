# Browser build settings. These are public values and are embedded in the client bundle.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_WEB_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# Leave empty when Static Web Apps proxies /api to the linked Functions app.
# Set only the API origin (without /api) when calling Functions directly.
VITE_API_BASE_URL=

# API-only settings. Copy these names and your real values to local.settings.json
# (do not commit it) or Azure Function App settings. Never add secrets to VITE_*.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=00000000-0000-0000-0000-000000000000
COSMOS_ENDPOINT=https://example.documents.azure.com:443/
APPLICATIONINSIGHTS_CONNECTION_STRING=
